{
  "name": "@hotel-pms/database",
  "version": "1.0.0",
  "description": "Shared Prisma ORM and PostgreSQL database layer for Hotel PMS",
  "author": "Adwait Kamble",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "npx prisma generate",
    "build": "tsc",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:studio": "npx prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "prisma": "^6.3.1",
    "typescript": "^5.7.2"
  }
}
